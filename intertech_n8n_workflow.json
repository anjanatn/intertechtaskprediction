{
  "name": "InterTech — High-Risk PM Confirmation Escalation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "high-risk-pm-confirmation",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "High-Risk Response Received",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "amount": 2,
        "unit": "hours"
      },
      "name": "Wait for PM Confirmation (2 Hours)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "resource": "issue",
        "operation": "get",
        "issueKey": "={{ $json.jira_ticket.key }}"
      },
      "name": "Read Jira Confirmation Status",
      "type": "n8n-nodes-base.jira",
      "typeVersion": 1,
      "position": [
        740,
        300
      ],
      "credentials": {
        "jiraSoftwareCloudApi": {
          "name": "InterTech Jira Cloud"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.fields.status.name }}",
              "operation": "equals",
              "value2": "In Progress"
            }
          ]
        }
      },
      "name": "PM Confirmed Reallocation?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        980,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "alerts@intertech.com",
        "toEmail": "={{ $node['High-Risk Response Received'].json.resource_manager_email }}",
        "subject": "={{ 'ESCALATION: ' + $node['High-Risk Response Received'].json.task_id + ' reallocation has not been confirmed' }}",
        "html": "=<h2>Escalation: PM confirmation overdue</h2><p><strong>{{ $node['High-Risk Response Received'].json.task_id }}</strong> remains high risk at <strong>{{ $node['High-Risk Response Received'].json.risk_score }}%</strong>.</p><p>The PM did not mark the response ticket <strong>{{ $node['High-Risk Response Received'].json.jira_ticket.key }}</strong> <em>In Progress</em> within two hours. Please secure a resource, document the decision, and update the ticket.</p><p>Tracking rule: {{ $node['High-Risk Response Received'].json.tracking_rule }}</p>",
        "options": {}
      },
      "name": "Email Resource Manager Escalation",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [
        1220,
        410
      ],
      "credentials": {
        "smtp": {
          "name": "InterTech SMTP"
        }
      }
    }
  ],
  "connections": {
    "High-Risk Response Received": {
      "main": [
        [
          {
            "node": "Wait for PM Confirmation (2 Hours)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait for PM Confirmation (2 Hours)": {
      "main": [
        [
          {
            "node": "Read Jira Confirmation Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Jira Confirmation Status": {
      "main": [
        [
          {
            "node": "PM Confirmed Reallocation?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "PM Confirmed Reallocation?": {
      "main": [
        [],
        [
          {
            "node": "Email Resource Manager Escalation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  }
}
